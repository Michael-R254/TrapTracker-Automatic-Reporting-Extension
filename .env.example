# TrapTracker Report — MACHINE-level configuration.
#
# Copy to .env and edit. Every key here has a working default, so this file is
# entirely optional: an install with no .env at all starts and runs.
#
# What is NOT here, deliberately: the mailbox, its password, the database, the
# image store, the site and its coordinates. Those describe a DEPLOYMENT, and a
# deployment is a project:
#
#     ttr project create                 # name, alert inbox, app password
#     ttr project set-site <project> --latitude <lat> --longitude <lon>
#
# The app password goes to the operating system's credential store, never to a
# file. The rest goes to the project's own project.toml.

# --- Crop path: independent detector + spatial match (Phase 2c) ---
# RT-DETR proposes candidate boxes on the CLEAN frame. It never sees a label, and
# its crop is what BioCLIP classifies. TrapTracker's own recovered box is used
# only to corroborate the choice, never as crop geometry -- that is what keeps
# the cross-check independent of TrapTracker's localisation (Decision 1).
# MegaDetector is deliberately not offered: every shipped inference path for it
# installs an AGPL-3.0 dependency and this project serves a web UI. Needs the
# [detect] extra.
DETECTOR_MODEL=PekingU/rtdetr_r50vd_coco_o365
DETECTOR_DEVICE=cpu
# Phase 2a operating point: 97.0% recall at IoU 0.5, ~4.9 candidates per frame,
# and no event left with none. Raising it costs recall faster than it buys
# precision.
DETECTOR_SCORE_THRESHOLD=0.30
# Separates cropped_verified from cropped_disputed. Derived in Phase 2a from the
# valley in the IoU distribution rather than picked by convention; anything in
# [0.20, 0.45] changes at most four of 819 verdicts.
CROP_IOU_TAU=0.30
# Context margin added around the detector's box before cropping.
CROP_PAD_FRAC=0.15

# --- BioCLIP taxonomic cross-check (Stage 3) ---
# Model name pinned in config; weights download once from HuggingFace.
# pybioclip 2.x also ships 'hf-hub:imageomics/bioclip-2' as its own default.
BIOCLIP_MODEL=hf-hub:imageomics/bioclip
BIOCLIP_DEVICE=cpu
BIOCLIP_TOPK=5
# Agreement join strategy. Default false = honest top-1 join (BioCLIP's single
# best guess vs the upstream label). True = laxer "upstream binomial anywhere in
# top-k" — provided only to compare both strategies for evaluation, NOT as the
# reported default (top-k inflates agreement in a way that means little).
AGREEMENT_TOPK_JOIN=false

# --- Ollama VLM + report LLM (Stage 3/4) ---
# ONE shared vision-capable model powers BOTH the VLM image describer and the
# report narrative. Pull it first: `ollama pull llava`. Keep the VLM describer
# and the report LLM on the SAME model so descriptions and narrative are coherent.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llava:latest
OLLAMA_TIMEOUT_SECONDS=60
# If true, describe the original image when the boxed one is missing (with a
# provenance note); default false records the failure rather than substituting.
VLM_FALLBACK_TO_ORIGINAL_ON_MISSING_BOXED=false

# --- Weather API access (the SERVICE, not the site) ---
# The camera's location lives on the PROJECT (ttr project set-site), because each
# deployment has its own and one having coordinates says nothing about another.
# These describe how to reach Open-Meteo, which is the same wherever the camera
# is. No API key is required. Responses are cached per-date in the project's own
# database, so repeated `ttr backfill-weather` runs make no API call.
WEATHER_ENDPOINT=https://archive-api.open-meteo.com/v1/archive
WEATHER_TIMEOUT_SECONDS=20
# A per-species weather sample below this N is flagged as too small to support a
# weather-preference claim.
WEATHER_SMALL_SAMPLE_THRESHOLD=20

# --- PDF rendering (optional) ---
# Full path to a Chrome/Edge executable. Unset = auto-discover the usual install
# locations. The bare TTR_BROWSER_EXECUTABLE / CHROME_PATH variables still work
# as a fallback for environments that cannot use a .env file.
# BROWSER_EXECUTABLE=

# --- Report presentation ---
# If false, the rendered report omits the BioCLIP agreement/cross-check flags
# (presentation only; the agreement data is still stored). A clean demo option.
REPORT_INCLUDE_CROSSCHECK=true

# --- Report thresholds ---
CONFIDENCE_LOW_FLAG_THRESHOLD=0.5
